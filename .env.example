# AI期货分析系统 - 环境变量配置文件
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制

# ================================================
# API 认证配置（必填）
# ================================================

# DeepSeek API 密钥
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 天勤 SDK 认证信息
# 格式：用户名,密码
# 注册地址：https://www.shinnytech.com/
TQSDK_AUTH=your_tqsdk_username,your_tqsdk_password

# ================================================
# 应用配置（可选）
# ================================================

# 调试模式
debug=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# ================================================
# Redis缓存配置（新增功能，可选）
# ================================================

# Redis服务器地址
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis数据库编号
REDIS_DB=0

# Redis密码（如无密码可留空）
REDIS_PASSWORD=

# ================================================
# Celery任务队列配置（新增功能，可选）
# ================================================

# Celery消息代理URL
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery结果存储URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ================================================
# 高级配置（可选，使用默认值可留空）
# ================================================

# 网络请求重试次数
# MAX_RETRY=3

# 网络请求超时时间（秒）
# REQUEST_TIMEOUT=30

# 数据库路径（默认：futures_analysis.db）
# DB_PATH=futures_analysis.db

# 新闻缓存时长（小时）
# NEWS_CACHE_HOURS=2

# ================================================
# 安全配置（生产环境必填）
# ================================================

# 管理员密码（首次运行自动创建管理员账户）
# 注意：请使用强密码，包含大小写字母、数字和特殊字符
ADMIN_PASSWORD=your_secure_admin_password

# 密钥（用于会话加密，请使用随机生成的长字符串）
SECRET_KEY=your_random_secret_key_here_at_least_32_characters
