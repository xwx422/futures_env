# 虚拟环境
venv/
ENV/

# 环境变量（含密钥）
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# macOS 系统文件
.DS_Store

# 大字体文件（使用 CDN 加载）
static/fonts/NotoSansSC-*.ttf
static/fonts/Inter-*.ttf

# Git 备份目录
.git_backup*/

# 模型文件
*.pth
*.bin
models/

# 数据库文件
*.db
instance/

# 日志文件
logs/

# Celery 调度文件
celerybeat-schedule
celerybeat-schedule.db

# ==================== 核心闭源模块 ====================
