[Unit]
Description=Celery Beat for futures-ai
After=network.target futures-ai-celery.service

[Service]
User=root
Group=root
Type=simple
WorkingDirectory=/var/www/futures_ai
ExecStart=/var/www/futures_ai/start_celery_beat.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=futures-ai-beat

[Install]
WantedBy=multi-user.target
